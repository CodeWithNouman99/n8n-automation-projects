    {
      "parameters": {
        "jsCode": "const devs = $('Get All Developers').all().map(i => i.json);\nconst progress = $('Get All Progress').all().map(i => i.json);\nconst questions = $('Get All Questions').all().map(i => i.json).filter(q => q.dev_id);\n\nconst TOTAL = 7;\nconst byManager = {};\n\nfor (const d of devs) {\n  if (!d.dev_id || !d.manager_whatsapp) continue;\n\n  const rows = progress.filter(p => p.dev_id === d.dev_id);\n  const done = rows.filter(p => p.status === 'Done').length;\n  const pending = rows.find(p => p.status === 'Pending');\n\n  let state = '🟢 On track';\n  if (d.status === 'Completed') {\n    state = '🏁 Completed';\n  } else if (pending) {\n    const days = Math.floor($now.diff(DateTime.fromISO(String(pending.assigned_date)), 'days').days);\n    if (days >= 2) state = `🔴 Stuck on ${pending.task_id} for ${days} days`;\n  }\n\n  const qs = questions.filter(q => q.dev_id === d.dev_id);\n  const notInDocs = qs.filter(q => String(q.found_in_docs).toLowerCase() === 'no').length;\n\n  const line =\n    `*${d.name}* (${d.role})\\n` +\n    `Day ${d.current_day} of ${TOTAL} | Tasks done: ${done}/${TOTAL}\\n` +\n    `${state}\\n` +\n    `Questions asked: ${qs.length} | Not in docs: ${notInDocs}`;\n\n  const key = String(d.manager_whatsapp);\n  if (!byManager[key]) byManager[key] = [];\n  byManager[key].push(line);\n}\n\nreturn Object.entries(byManager).map(([manager_whatsapp, lines]) => ({\n  json: {\n    manager_whatsapp,\n    report:\n      `📊 *DevBuddy Weekly Report*\\n` +\n      `${$now.toFormat('dd LLL yyyy')}\\n` +\n      `Developers: ${lines.length}\\n\\n` +\n      lines.join('\\n\\n'),\n  },\n}));"
      },
